APP_NAME="Dr. Funmilola Wuraola"
APP_ENV=production
APP_KEY=GENERATE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://practice.example.org
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=practice
DB_USERNAME=practice
DB_PASSWORD=INJECT_FROM_SECRET_MANAGER

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=INJECT_FROM_SECRET_MANAGER

FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=INJECT_PROVIDER_HOST
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=INJECT_FROM_SECRET_MANAGER
MAIL_PASSWORD=INJECT_FROM_SECRET_MANAGER
MAIL_FROM_ADDRESS=practice@example.org
MAIL_FROM_NAME="${APP_NAME}"

VIDEO_PROVIDER=unconfigured
SMS_PROVIDER=unconfigured
PAYMENT_PROVIDER=unconfigured
ANALYTICS_PROVIDER=unconfigured
